# ==========================================
# CoalGuard Environment Variables Configuration
# ==========================================

# Frontend (Vercel)
# In development: leaves blank to use local proxy /api
# In production on Vercel: set to your Render backend API URL:
# VITE_API_BASE=https://coalguard-backend.onrender.com/api
VITE_API_BASE=/api

# Backend (Render)
NODE_ENV=production
# PORT is automatically injected by Render (defaults to 3000 locally)
PORT=3000
